# ==============================================================================
# AFRI-KA WEB - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (COOLIFY / VITE)
# ==============================================================================
# IMPORTANT SOUS COOLIFY :
# Vite injecte les variables commençant par "VITE_" LORS DU BUILD (à la compilation).
# Dans Coolify > Application > Configuration > Environment Variables,
# veillez à cocher la case "Build Variable" (ou "Available during build") pour VITE_API_URL.
# ==============================================================================

# URL absolue de l'API backend en production (avec le préfixe de version /api/v1) :
# Exemple : https://api.afri-ka.com/api/v1
VITE_API_URL=https://api.afri-ka.com/api/v1

# URL racine du backend Django (sans /api/v1) pour les redirections ou médias :
VITE_BACKEND_URL=https://api.afri-ka.com

# Nom officiel de l'application affiché dans l'interface :
VITE_APP_NAME=Afri'Ka
